GDP= INTEG (
	GDP growth,
		430)
	~	
	~		|

GDP per capita=
	GDP/Population
	~	
	~		|

birth rate= WITH LOOKUP (
	GDP per capita,
		([(0,0.02)-(20,0.05)],(0.440367,0.028819),(1.22324,0.032),(1.89602,0.0307),(3.18043\
		,0.0307),(20,0.0307) ))
	~	
	~	0.031
		([(0,0.02)-(17,0.05)],(0.440367,0.028819),(1.22324,0.0320762),(2.28746,0.0334211),(3.\
		63914,0.0336842),(4.52294,0.0322368),(5.30275,0.0290789),(6.3945,0.0256579)\
		,(8.11009,0.0234211),(10.0795,0.0221053),(12.2324,0.0215789),(14.1407,0.021\
		4474),(16.0979,0.0213) )
		([(0,0.02)-(17,0.05)],(0.440367,0.028819),(1.22324,0.0320762),(1.81957,0.03\
		),(2.5474,0.0273684),(4.21101,0.027),(16.2722,0.027) )
	|

GDP growth rate= WITH LOOKUP (
	Time,
		([(0,0)-(2021,0.07)],(1500,0.0007),(1820,0.006),(1950,0.025),(1980,0.06),(1990,0.02\
		),(2021,0.05) ))
	~	
	~		|

average life expectancy= WITH LOOKUP (
	Time,
		([(0,0)-(2021,70)],(0,35),(1800,35),(1950,50),(2000,70),(2021,70) ))
	~	
	~		|

Population= INTEG (
	births-deaths,
		458)
	~	
	~		|

real data population= WITH LOOKUP (
	Time,
		([(1500,0)-(2020,8000)],(1500,458),(1600,580),(1700,682),(1800,978),(1900,1650),(2000\
		,5978),(2020,7758) ))
	~	
	~		|

births=
	Population*birth rate
	~	
	~		|

GDP growth=
	GDP*GDP growth rate
	~	
	~		|

deaths=
	Population/average life expectancy
	~	
	~		|

