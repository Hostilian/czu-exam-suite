{UTF-8}
roční míra porodnosti= WITH LOOKUP (
	HDP per capita,
		([(0,0)-(20,0.035)],(0.440367,0.028819),(1.22324,0.032),(1.89602,0.0307),(20,0.0307\
		) ))
	~	
	~		|

HDP per capita=
	HDP/Světová populace
	~	
	~		|

míra růstu HDP= WITH LOOKUP (
	Time,
		([(1500,0)-(2021,0.1)],(1500,0.0007),(1820,0.006),(1950,0.025),(1980,0.06),(1990,0.02\
		),(2021,0.05) ))
	~	
	~		|

růstu HDP=
	HDP*míra růstu HDP
	~	
	~		|

HDP= INTEG (
	růstu HDP,
		430)
	~	
	~		|

průměrná naděje na dožití= WITH LOOKUP (
	Time,
		([(0,0)-(2020,70)],(1500,35),(1800,35),(1950,50),(2000,70),(2020,70) ))
	~	
	~		|

Světová populace= INTEG (
	rození-umírání,
		458)
	~	
	~		|

rození=
	Světová populace*roční míra porodnosti
	~	
	~		|

umírání=
	Světová populace/průměrná naděje na dožití
	~	
	~		|

reálná populace= WITH LOOKUP (
	Time,
		([(1500,0)-(2020,8000)],(1500,458),(1600,580),(1700,682),(1800,978),(1900,1650),(2000\
		,5978),(2020,7758) ))
	~	
	~		|

