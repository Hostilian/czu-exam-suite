{UTF-8}
birth rate=
	0.031
	~	
	~		|

average life expectancy= WITH LOOKUP (
	Time,
		([(0,0)-(2000,70)],(0,35),(1800,35),(1950,50),(2000,70) ))
	~	
	~		|

Population= INTEG (
	births-deaths,
		458)
	~	
	~		|

real population= WITH LOOKUP (
	Time,
		([(1500,0)-(2020,8000)],(1500,458),(1600,580),(1700,682),(1800,978),(1900,1650),(2000\
		,5978),(2020,7758) ))
	~	
	~		|

births=
	Population*birth rate
	~	
	~		|

deaths=
	Population/average life expectancy
	~	
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 2020
	~	Year
	~	The final time for the simulation.
	|

INITIAL TIME  = 1500
	~	Year
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.125
	~	Year [0,?]
	~	The time step for the simulation.
	|

