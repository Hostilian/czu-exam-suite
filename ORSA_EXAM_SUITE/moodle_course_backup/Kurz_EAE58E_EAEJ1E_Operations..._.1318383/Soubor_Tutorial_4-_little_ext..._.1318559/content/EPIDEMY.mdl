{UTF-8}
AVERAGE NUMBER OF RISK CONTACTS=
	10
	~	
	~		|

totla number of risk contacts=
	Susceptible population*AVERAGE NUMBER OF RISK CONTACTS
	~	
	~		|

Total deaths= INTEG (
	death rate,
		0)
	~	
	~		|

AVERAGE DUTATION OF INFECTION=
	7
	~	
	~		|

Imune population= INTEG (
	recovery with imunity,
		0)
	~	
	~		|

Infected population= INTEG (
	infection rate-recovery without imunity-recovery with imunity-death rate,
		10)
	~	
	~		|

exit rate=
	Infected population/AVERAGE DUTATION OF INFECTION
	~	
	~		|

infection rate=
	totla number of risk contacts*share of infected on the total population*INFECTIVITY
	~	
	~		|

INFECTIVITY=
	0.05
	~	
	~		|

Susceptible population= INTEG (
	recovery without imunity-infection rate,
		49990)
	~	
	~		|

share of infected on the total population=
	Infected population/(Infected population+Susceptible population+Imune population)
	~	
	~		|

SHARE OF IMUNE=
	0.5
	~	
	~		|

MORTALITY=
	0.03
	~	
	~		|

recovery rate=
	exit rate*(1-MORTALITY)
	~	
	~		|

recovery without imunity=
	recovery rate*(1-SHARE OF IMUNE)
	~	
	~		|

recovery with imunity=
	recovery rate*SHARE OF IMUNE
	~	
	~		|

death rate=
	exit rate*MORTALITY
	~	
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 100
	~	Day
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Day
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Day [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.03125
	~	Day [0,?]
	~	The time step for the simulation.
	|

